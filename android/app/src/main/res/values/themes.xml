<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown by the system before the first frame: a plain night screen, so the animated Compose splash takes over without a jump. -->
    <style name="Theme.Mashhad.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Mashhad</item>
    </style>

    <style name="Theme.Mashhad" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
